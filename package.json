{
  "name": "windows-sms-bridge",
  "productName": "Windows SMS Bridge",
  "version": "1.2.0",
  "description": "Windows client for the Android SMS bridge (短信桥)",
  "main": "main.js",
  "author": "Windows SMS Bridge",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "npx @electron/packager . \"Windows SMS Bridge\" --platform=win32 --arch=x64 --out=dist --icon=assets/icon.ico --overwrite --app-version=1.2.0 --ignore=\"^/(dist|\\\\.shots|\\\\.demo-data|tools|\\\\.git)(/|$)\"",
    "icons": "python tools/make_icons.py",
    "i18n:check": "node scripts/i18n-sweep.js",
    "avatar:contrast": "node scripts/avatar-contrast.js",
    "dist": "electron-builder --win nsis zip"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.windowssmsbridge.windows",
    "productName": "Windows SMS Bridge",
    "copyright": "MIT licensed",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "assets/**/*",
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Windows SMS Bridge",
      "artifactName": "Windows-SMS-Bridge-Setup-${version}.${ext}",
      "uninstallDisplayName": "Windows SMS Bridge"
    }
  }
}