<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- glass fill -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#14FFFFFF" />
        </shape>
    </item>

    <!-- top highlight: a 1dp gradient stroke reads as a glass edge -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#59FFFFFF"
                android:centerColor="#1FFFFFFF"
                android:endColor="#0DFFFFFF" />
            <stroke android:width="1dp" android:color="#00000000" />
        </shape>
    </item>

    <!-- inner outline to separate from the background -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
