<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="GlassCard" parent="">
        <item name="android:background">@drawable/bg_glass_card</item>
    </style>

    <!-- secondary glass button -->
    <style name="GlassButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">#1AFFFFFF</item>
        <item name="android:textColor">#E8FFFFFF</item>
        <item name="cornerRadius">20dp</item>
        <item name="strokeColor">#33FFFFFF</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <!-- primary action: soft teal gradient -->
    <style name="GlassButtonPrimary" parent="Widget.Material3.Button">
        <item name="backgroundTint">#2E7D6B</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="cornerRadius">20dp</item>
        <item name="strokeColor">#66FFFFFF</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <!-- subtle text button -->
    <style name="GlassTextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">#8FD8C8</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- frosted card used by the proactive notification page -->
    <style name="GlassCardView" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardBackgroundColor">#14FFFFFF</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">#33FFFFFF</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- single-select interval chip -->
    <style name="GlassChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="android:textColor">#E8FFFFFF</item>
        <item name="chipStrokeColor">#33FFFFFF</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textSize">13sp</item>
        <item name="chipMinHeight">36dp</item>
    </style>
</resources>
