# Android build output
build/
.gradle/
.kotlin/
local.properties
*.iml
.idea/

# Built APKs (released through GitHub Releases, not the repo)
*.apk
*.aab

# build.ps1 output: the APK plus the Windows installer (87 MB) and zip (111 MB)
dist/

# TLS private material — never commit, regenerate with tools/gen_cert.py
keystore/
android/app/src/main/assets/server.p12

# Public pinned certificate, produced by TOFU or by tools/gen_cert.py.
# Not committed: a fresh clone trusts the phone on first pair instead.
mcp/smsbridge-cert.pem

# Agent credentials (contains the pairing token) — never commit
mcp/.smsbridge.json

# Python
__pycache__/
*.pyc

# OS noise
.DS_Store
Thumbs.db
